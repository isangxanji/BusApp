<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:elevation="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/btnHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Home"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_home"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/btnBuses"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Buses"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_bus"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/btnUpdates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Updates"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_updates"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/btnAbout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="About"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_about"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary"
        android:includeFontPadding="false"/>

</LinearLayout>