<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:elevation="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/btnStaffDashboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Dashboard"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_dashboard"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary" />

    <TextView
        android:id="@+id/btnStaffRecord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Record"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_record"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary" />

    <TextView
        android:id="@+id/btnStaffBuses"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Buses"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_bus"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary" />

    <TextView
        android:id="@+id/btnStaffTrips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="4dp"
        android:text="Trips"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:drawableTop="@drawable/ic_nav_trips"
        android:drawablePadding="4dp"
        android:drawableTint="@color/text_secondary" />

</LinearLayout>