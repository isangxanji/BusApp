<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mindanao Bus Info"
            android:textColor="@color/primary_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STAFF PORTAL"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtLoginHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Staff Login"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtLoginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in using your authorized staff credentials."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Staff ID"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/inputStaffId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:hint="Enter your Staff ID"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:singleLine="true"
            android:inputType="textCapCharacters" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/inputStaffPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:hint="Enter your password"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:singleLine="true"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnStaffLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Log In"
            android:textColor="@color/surface"
            android:backgroundTint="@color/primary" />

        <TextView
            android:id="@+id/btnRegisterStaff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Register account"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/btnRequestStaffAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Need an account? Submit request"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="&lt; Back to Passenger Home"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:singleLine="true"
            android:padding="12dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</LinearLayout>